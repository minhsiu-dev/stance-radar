# Optional, for disk-constrained environments (e.g. CI sandbox) — packages the host-built
# .next/standalone directly, skipping in-container npm ci. Requires a prior npm run build in frontend/.
# The normal E2E flow uses the default Dockerfile; select this one via a compose dockerfile: override.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY .next/standalone ./
COPY .next/static ./.next/static
COPY public ./public
EXPOSE 3000
CMD ["node", "server.js"]
