# Required
YOUTUBE_API_KEY=your-youtube-data-api-key

# Optional (defaults shown below)
# The LLM runs via the Claude Code CLI (`claude -p`); you must `claude login` on
# the host first, and ~/.claude is mounted into the api container. No
# ANTHROPIC_API_KEY is needed.
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-haiku-4-5
BACKFILL_LIMIT=30
ANALYSIS_CONCURRENCY=2
# Check for new videos every N minutes; channels with auto_analyze on will
# analyze new uploads directly (0 = disabled)
AUTO_REFRESH_MINUTES=0
# Skip imported videos this many seconds or shorter (Shorts / too-short clips); 0 disables
SHORTS_MAX_SECONDS=240
# Admin lock: password to add/remove channels, review videos, trigger analysis (empty = all writes denied)
ADMIN_PASSWORD=
# Minutes of inactivity before the admin session expires, sliding (0 = permanent)
ADMIN_SESSION_MINUTES=30
# Set true when serving over HTTPS (e.g. behind the Cloudflare tunnel) so the cookie is marked Secure
ADMIN_COOKIE_SECURE=false

# --- Opt-in VPN proxy (only used with docker-compose.vpn.yml) ---
# NordVPN "service credentials" from the NordVPN dashboard (NOT your login).
OPENVPN_USER=your-nordvpn-service-username
OPENVPN_PASSWORD=your-nordvpn-service-password
# Rotation pool (gluetun SERVER_COUNTRIES); pick where Yahoo/YouTube work for you
SERVER_COUNTRIES=United States
